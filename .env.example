# Copy to .env.local and fill in. Never commit .env.local.

# Speech-to-text (https://console.soniox.com). Server-side only; the browser gets 60s temporary keys.
SONIOX_API_KEY=

# Any OpenAI-compatible chat API. Examples:
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-5-mini
#   Gemini:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=openai/gpt-oss-20b
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1                           LLM_MODEL=<provider/model>
#   OpenCode Zen:  LLM_BASE_URL=https://opencode.ai/zen/v1                             LLM_MODEL=<model id from your Zen dashboard>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to "off" if your provider rejects response_format={"type":"json_object"}.
LLM_JSON_MODE=on
# Optional: request timeout in ms (raise for slow free/local backends).
# LLM_TIMEOUT_MS=25000
